# ─────────────────────────────────────────────────────────────
# StreamPay environment template. Copy to .env and fill in.
# The web app reads only VITE_-prefixed vars at build time.
# ─────────────────────────────────────────────────────────────

# ---- Frontend (apps/web) ----
# Deployed subscription contract id, a 56-char C-address (e.g. CAAAA...Q. Get it
# from `stellar contract deploy` — see README "Deploy". IMPORTANT: leave this
# EMPTY to run the UI in MOCK MODE; any non-empty value switches the app to live
# mode and it will try to talk to that exact contract id.
VITE_CONTRACT_ID=
# Network passphrase. Testnet shown below; use "Public Global Stellar Network ; September 2015" for mainnet.
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Soroban RPC endpoint.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Horizon endpoint for classic operations (XLM balance + native payments). This
# powers the Level 1 wallet flow (connect → balance → send), which is always live
# against the network regardless of VITE_CONTRACT_ID.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
# Human-readable network label used by the wallet kit ("TESTNET" | "PUBLIC").
VITE_NETWORK=TESTNET

# ---- Watcher (apps/watcher) ----
# Secret key (S...) of a funded account that pays fees and submits pay_next().
WATCHER_SECRET=
# Same contract id as above.
CONTRACT_ID=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Poll interval in seconds for the watcher loop.
POLL_INTERVAL_SECS=30
